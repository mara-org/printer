# Copy this file to .env.local and fill in the values you have.
# See SETUP.md for where each value comes from.

# ─── Supabase (already provisioned) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://qcrrfisswbaecuipcatr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server only, never ship to browser
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI providers ───────────────────────────────────────────────
GEMINI_API_KEY=
HUGGINGFACE_TOKEN=

# ─── Payments: Polar.sh (Merchant of Record, accepts KSA sellers) ─
# Get from https://polar.sh after creating your organization.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORG_ID=
# Polar product IDs (created later in the next sprint)
NEXT_PUBLIC_POLAR_PRODUCT_PRO=
NEXT_PUBLIC_POLAR_PRODUCT_POWER=
NEXT_PUBLIC_POLAR_PRODUCT_LIFETIME=

# ─── Email ──────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── Bot protection (Cloudflare Turnstile, free) ────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Rate limiting (Upstash Redis, free) ────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Cron auth (must match GitHub Secrets value) ────────────────
CRON_SECRET=

# ─── Errors (Sentry, free 5K events/mo) ─────────────────────────
SENTRY_DSN=

# ─── Analytics ──────────────────────────────────────────────────
# Vercel Analytics is enabled in the Vercel dashboard with one click;
# no env var needed. The <Analytics /> component is already wired in
# app/layout.tsx.

# ─── Stock media (Pexels, free) ─────────────────────────────────
PEXELS_API_KEY=

# ─── Master kill switch (default unset / false) ─────────────────
KILL_SWITCH=
